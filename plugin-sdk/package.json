{
  "name": "@amaan/plugin-sdk",
  "version": "0.0.1",
  "private": false,
  "description": "Minimal wrapper SDK to make OpenCode plugins easier to write.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./opencode": {
      "types": "./dist/opencode/src/index.d.ts",
      "import": "./dist/opencode/src/index.js"
    },
    "./pi": {
      "types": "./dist/pi/src/index.d.ts",
      "import": "./dist/pi/src/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.28"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
